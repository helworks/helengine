<Project>
  <PropertyGroup>
    <HelengineRealStorageBits Condition="'$(HelengineRealStorageBits)' == ''">32</HelengineRealStorageBits>
    <HelengineRealArithmeticBits Condition="'$(HelengineRealArithmeticBits)' == ''">32</HelengineRealArithmeticBits>
  </PropertyGroup>

  <Target Name="GenerateHelengineNumericRepresentation" BeforeTargets="CoreCompile">
    <Error Condition="'$(HelengineRealStorageBits)' != '16' And '$(HelengineRealStorageBits)' != '32' And '$(HelengineRealStorageBits)' != '64'"
           Text="Managed engine numeric storage supports only 16, 32 or 64 bits; requested $(HelengineRealStorageBits)." />
    <Error Condition="'$(HelengineRealArithmeticBits)' != '16' And '$(HelengineRealArithmeticBits)' != '32' And '$(HelengineRealArithmeticBits)' != '64'"
           Text="Managed engine numeric arithmetic supports only 16, 32 or 64 bits; requested $(HelengineRealArithmeticBits)." />
    <Error Condition="('$(HelengineRealStorageBits)' == '16' And '$(HelengineRealArithmeticBits)' == '64') Or ('$(HelengineRealArithmeticBits)' == '16' And '$(HelengineRealStorageBits)' != '16')"
           Text="Managed binary16 supports only 16/16 and 16/32." />
    <PropertyGroup>
      <_HelengineStorageType Condition="'$(HelengineRealStorageBits)' == '16'">System.Half</_HelengineStorageType>
      <_HelengineStorageType Condition="'$(HelengineRealStorageBits)' == '32'">System.Single</_HelengineStorageType>
      <_HelengineStorageType Condition="'$(HelengineRealStorageBits)' == '64'">System.Double</_HelengineStorageType>
      <_HelengineArithmeticType Condition="'$(HelengineRealArithmeticBits)' == '16'">System.Half</_HelengineArithmeticType>
      <_HelengineArithmeticType Condition="'$(HelengineRealArithmeticBits)' == '32'">System.Single</_HelengineArithmeticType>
      <_HelengineArithmeticType Condition="'$(HelengineRealArithmeticBits)' == '64'">System.Double</_HelengineArithmeticType>
      <_HelengineArithmeticMath Condition="'$(HelengineRealArithmeticBits)' == '16' Or '$(HelengineRealArithmeticBits)' == '32'">System.MathF</_HelengineArithmeticMath>
      <_HelengineArithmeticMath Condition="'$(HelengineRealArithmeticBits)' == '64'">System.Math</_HelengineArithmeticMath>
      <_HelengineMathType Condition="'$(HelengineRealArithmeticBits)' != '64'">System.Single</_HelengineMathType>
      <_HelengineMathType Condition="'$(HelengineRealArithmeticBits)' == '64'">System.Double</_HelengineMathType>
      <_HelengineNumericSource>$(IntermediateOutputPath)NumericPrecision.g.cs</_HelengineNumericSource>
    </PropertyGroup>
    <ItemGroup>
      <_HelengineNumericSourceLine Include="// Generated from this build's numeric policy. Do not edit." />
      <_HelengineNumericSourceLine Include="global using RealStorageScalar = $(_HelengineStorageType)%3B" />
      <_HelengineNumericSourceLine Include="global using RealArithmeticScalar = $(_HelengineArithmeticType)%3B" />
      <_HelengineNumericSourceLine Include="global using RealArithmeticMath = $(_HelengineArithmeticMath)%3B" />
      <_HelengineNumericSourceLine Include="global using RealMathScalar = $(_HelengineMathType)%3B" />
      <_HelengineNumericSourceLine Include="namespace helengine {" />
      <_HelengineNumericSourceLine Include="/// &lt;summary&gt;Numeric representation compiled for this managed runtime build.&lt;/summary&gt;" />
      <_HelengineNumericSourceLine Include="public static class RealRepresentation {" />
      <_HelengineNumericSourceLine Include="/// &lt;summary&gt;Selected stored scalar width.&lt;/summary&gt;" />
      <_HelengineNumericSourceLine Include="public const int StorageBits = $(HelengineRealStorageBits)%3B" />
      <_HelengineNumericSourceLine Include="/// &lt;summary&gt;Selected arithmetic scalar width.&lt;/summary&gt;" />
      <_HelengineNumericSourceLine Include="public const int ArithmeticBits = $(HelengineRealArithmeticBits)%3B" />
      <_HelengineNumericSourceLine Include="/// &lt;summary&gt;Immutable numeric contract implemented by this assembly.&lt;/summary&gt;" />
      <_HelengineNumericSourceLine Include="public static NumericPrecisionPolicy Policy { get%3B } = new NumericPrecisionPolicy(StorageBits, ArithmeticBits)%3B" />
      <_HelengineNumericSourceLine Include="}" />
      <_HelengineNumericSourceLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_HelengineNumericSource)" Lines="@(_HelengineNumericSourceLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_HelengineNumericSource)" />
      <FileWrites Include="$(_HelengineNumericSource)" />
    </ItemGroup>
  </Target>
</Project>
