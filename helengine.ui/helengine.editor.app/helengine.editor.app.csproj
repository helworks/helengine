<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows</TargetFramework>
		<Nullable>disable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
		<EnableWindowsFormsHighDpiAutoResizing>false</EnableWindowsFormsHighDpiAutoResizing>
		<AddSyntheticProjectReferencesForSolutionDependencies>false</AddSyntheticProjectReferencesForSolutionDependencies>
		<RestoreBuildInParallel>false</RestoreBuildInParallel>
	</PropertyGroup>

	<PropertyGroup Condition="'$(BuildingInsideVisualStudio)' == 'true'">
		<BaseOutputPath>bin\vs\</BaseOutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<NoWarn>1701;1702;WFO1000</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<NoWarn>1701;1702;WFO1000</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Theming\**" />
		<EmbeddedResource Remove="Theming\**" />
		<None Remove="Theming\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.Drawing.Common" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="content\icons\toolbar\*.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>content\icons\toolbar\%(Filename)%(Extension)</TargetPath>
		</Content>
		<Content Include="content\icons\toolbar\*.svg">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>content\icons\toolbar\%(Filename)%(Extension)</TargetPath>
		</Content>
		<Content Include="content\icons\titlebar\*.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>content\icons\titlebar\%(Filename)%(Extension)</TargetPath>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\engine\helengine.core.windows\helengine.core.windows.csproj" SkipGetTargetFrameworkProperties="true" />
		<ProjectReference Include="..\..\engine\helengine.baseplatform\helengine.baseplatform.csproj" SkipGetTargetFrameworkProperties="true" />
		<ProjectReference Include="..\..\engine\helengine.core\helengine.core.csproj" SkipGetTargetFrameworkProperties="true" />
		<ProjectReference Include="..\..\engine\helengine.editor.windows.gdiimporter\helengine.editor.windows.gdiimporter.csproj" SkipGetTargetFrameworkProperties="true" />
		<ProjectReference Include="..\..\engine\helengine.editor.windows.pfimimporter\helengine.editor.windows.pfimimporter.csproj" SkipGetTargetFrameworkProperties="true" />
		<ProjectReference Include="..\..\engine\helengine.editor.windows.magickimporter\helengine.editor.windows.magickimporter.csproj" SkipGetTargetFrameworkProperties="true" />
		<ProjectReference Include="..\..\engine\helengine.editor.windows.audioimporter\helengine.editor.windows.audioimporter.csproj" SkipGetTargetFrameworkProperties="true" />
		<ProjectReference Include="..\..\engine\helengine.files\helengine.files.csproj" SkipGetTargetFrameworkProperties="true" />
		<ProjectReference Include="..\..\engine\helengine.input\helengine.input.csproj" SkipGetTargetFrameworkProperties="true" />
		<ProjectReference Include="..\..\engine\helengine.bepu\helengine.bepu.csproj" SkipGetTargetFrameworkProperties="true" />
		<ProjectReference Include="..\..\engine\helengine.editor.fbximporter\helengine.editor.assimp.csproj" SkipGetTargetFrameworkProperties="true" />
		<ProjectReference Include="..\..\engine\helengine.editor.windows\helengine.editor.windows.csproj" SkipGetTargetFrameworkProperties="true" />
		<ProjectReference Include="..\..\engine\helengine.editor\helengine.editor.csproj" SkipGetTargetFrameworkProperties="true" />
		<ProjectReference Include="..\..\engine\helengine.directx11\helengine.directx11.csproj" SkipGetTargetFrameworkProperties="true" />
		<ProjectReference Include="..\..\engine\helengine.platforms\helengine.platforms.csproj" SkipGetTargetFrameworkProperties="true" />
		<ProjectReference Include="..\..\engine\helengine.projectfile\helengine.projectfile.csproj" SkipGetTargetFrameworkProperties="true" />
		<ProjectReference Include="..\..\engine\helengine.shader.compilation\helengine.shader.compilation.csproj" SkipGetTargetFrameworkProperties="true" />
		<ProjectReference Include="..\..\engine\helengine.vulkan\helengine.vulkan.csproj" SkipGetTargetFrameworkProperties="true" />
	</ItemGroup>

	<!--
		Builds the desktop player (deliberately not a ProjectReference, which would copy its executable into the editor's own output root) and copies its complete build output into a "player" folder beside the editor executable, the same
		"published tool in a folder beside the editor" layout the codegen tool uses. The player keeps its own deps.json,
		runtimeconfig.json and shader folders there instead of mixing them into the editor's output.
	-->
	<Target Name="CopyHelenginePlayer" AfterTargets="Build">
		<MSBuild Projects="..\..\engine\helengine.player\helengine.player.csproj" Targets="Build" Properties="Configuration=$(Configuration)">
			<Output TaskParameter="TargetOutputs" ItemName="HelenginePlayerTargetPath" />
		</MSBuild>
		<PropertyGroup>
			<HelenginePlayerOutputDirectory>@(HelenginePlayerTargetPath->'%(RootDir)%(Directory)')</HelenginePlayerOutputDirectory>
		</PropertyGroup>
		<ItemGroup>
			<HelenginePlayerOutputFile Include="$(HelenginePlayerOutputDirectory)**\*" />
		</ItemGroup>
		<Error Condition="!Exists('$(HelenginePlayerOutputDirectory)helengine.player.exe')" Text="The desktop player was not built at '$(HelenginePlayerOutputDirectory)helengine.player.exe'." />
		<!-- Engine projects build into a common output without copy-local, so the player's own bin holds only its five
		     files. Its dependencies (engine and package assemblies, native runtimes, shaders) are exactly the ones the
		     editor output already carries, so they are mirrored into player\ before the player's own files. -->
		<ItemGroup>
			<HelenginePlayerRootDependency Include="$(OutDir)*.dll" Exclude="$(OutDir)helengine.editor.app.dll" />
			<HelenginePlayerRuntimeDependency Include="$(OutDir)runtimes\**\*" />
			<HelenginePlayerShaderDependency Include="$(OutDir)shaders\**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(HelenginePlayerRootDependency)" DestinationFolder="$(OutDir)player" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(HelenginePlayerRuntimeDependency)" DestinationFiles="@(HelenginePlayerRuntimeDependency->'$(OutDir)player\runtimes\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(HelenginePlayerShaderDependency)" DestinationFiles="@(HelenginePlayerShaderDependency->'$(OutDir)player\shaders\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(HelenginePlayerOutputFile)" DestinationFiles="@(HelenginePlayerOutputFile->'$(OutDir)player\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>

</Project>
