namespace CityFixture.Rendering;

sealed class NintendoDsLightToggleOverlayComponent {
    readonly string WhiteLightColor = "white";
    readonly string YellowLightColor = "yellow";
    readonly string RedLightColor = "red";
    readonly string BlueLightColor = "blue";
    readonly string GreenLightColor = "green";
    readonly string OffSwatchColor = "off";

    void Attach(Interactable BoundInteractable) {
        BoundInteractable.CursorEvent += HandleCursorEvent;
    }

    void HandleCursorEvent(PointerInteraction interaction) {
        if (interaction == PointerInteraction.Press || interaction == PointerInteraction.Release) {
            AdvanceLightState();
        }
        if (InputGamepadButton.RightShoulder) {
            AdvanceLightState();
        }
    }

    void AdvanceLightState() { }
}
