namespace CityFixture.GameTools;

sealed class GameSceneFactory {
    public GeneratedScene CreateTiltTrialScene() {
        return new GeneratedScene {
            Lights = [
                CreateDirectionalLightEntity(),
                CreateDirectionalFillLightEntity(),
            ]
        };
    }

    GeneratedEntity CreateDirectionalFillLightEntity() {
        Entity entity = Core.Instance.EntityFactory.Create("TiltTrialFill");
        return new GeneratedEntity { Intensity = 0.7f, ShadowsEnabled = false, Entity = entity };
    }

    GeneratedEntity CreateDirectionalLightEntity() => new GeneratedEntity();
}
