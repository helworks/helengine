namespace CityFixture.RenderingTools;

sealed class NintendoDsRenderingSceneScaffoldFactory {
    const int ScreenHeight = 192;
    const int NintendoDsBackButtonHeight = 32;
    const int NintendoDsBackButtonTop = ScreenHeight - NintendoDsBackButtonHeight - 6;
    const int NintendoDsBackButtonLabelTop = 6;
    const int NintendoDsLightButtonLabelTop = 6;
    const int NintendoDsLightSwatchTop = 4;
    const byte NintendoDsLightSwatchRenderOrder = 209;

    float4 clearColor = new float4(30f / 255f, 17f / 255f, 41f / 255f, 1f);

    GeneratedEntity BuildBottomScreen() {
        GeneratedEntity lightButton = CreateBottomScreenLightButton(FontScale = 1f);
        GeneratedEntity backButton = CreateBottomScreenBackButton(NintendoDsBackButtonTop);
        GeneratedEntity swatch = new GeneratedEntity { Name = "DemoDiscBottomScreenLightSwatch", RenderOrder2D = NintendoDsLightSwatchRenderOrder };
        swatch.Label = "DemoDiscBottomScreenLightButtonLabel";
        backButton.Label = "DemoDiscBottomScreenLightButton";
        return new GeneratedEntity[] { lightButton, backButton, swatch }[0];
    }

    GeneratedEntity CreateBottomScreenLightButton(float FontScale) => new GeneratedEntity();
    GeneratedEntity CreateBottomScreenBackButton(int top) => new GeneratedEntity();
}
