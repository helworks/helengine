namespace CityFixture.RenderingTools;

sealed class ColoredCubeGridSceneFactory {
    const string GameCubeMaterialSchemaId = "standard-shader";

    void AuthorMaterial(int cubeIndex, GeneratedSceneDefinition definition) {
        GeneratedMaterialPlatformDefinition gameCubeSettings = definition.GetOrCreatePlatform("gamecube");
        gameCubeSettings.SchemaId = GameCubeMaterialSchemaId;
        gameCubeSettings.SetFieldValue(BaseColorFieldId, CubeMaterialColors[cubeIndex]);
        gameCubeSettings.SetFieldValue(DoubleSidedFieldId, "false");
        gameCubeSettings.SetFieldValue(VertexColorModeFieldId, "ignore");
        gameCubeSettings.SetFieldValue(LightingModeFieldId, "lit");
    }

    Entity[] BuildNintendoDsRootEntities(Entity cameraEntity, Entity directionalLightEntity, Entity[] cubeEntities) {
        Entity[] nintendoDsRootEntities = new Entity[cubeEntities.Length + 3];
        nintendoDsRootEntities[0] = cameraEntity;
        nintendoDsRootEntities[1] = CreateNintendoDsPerfUiEntity();
        nintendoDsRootEntities[2] = directionalLightEntity;
        Array.Copy(cubeEntities, 0, nintendoDsRootEntities, 3, cubeEntities.Length);
        return nintendoDsRootEntities;
    }

    GeneratedSceneDefinition BuildScene(Entity[] rootEntities) {
        return new GeneratedSceneDefinition {
            RootEntities = rootEntities,
            UseDefaultBottomOverlay = true,
            BottomScreenRootEntities = Array.Empty<Entity>()
        };
    }

    GeneratedSceneDefinition BuildNintendoDsScene(Entity[] nintendoDsRootEntities) {
        return new GeneratedSceneDefinition {
            RootEntities = nintendoDsRootEntities,
            BottomScreenRootEntities = Array.Empty<Entity>()
        };
    }

    void AddUi(Entity[] rootEntities) {
        rootEntities[2] = CreateUiEntity();
    }

    Entity CreateNintendoDsPerfUiEntity() => new Entity();
    Entity CreateUiEntity() => new Entity();
}
