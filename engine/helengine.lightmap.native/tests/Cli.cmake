# Exercise parsing and persisted assets through the real command-line executable.
set(SCENE "${OUTPUT_DIRECTORY}/cli-test.scene")
set(ATLAS "${OUTPUT_DIRECTORY}/cli-test.lightmap")
execute_process(COMMAND "${TESTS}" --cli-fixture "${SCENE}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE LOG ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "CLI fixture failed: ${LOG}${ERROR}")
endif()
foreach(ANGLE IN ITEMS -0.1 20.01 nan inf -inf 1suffix 1e1000)
    execute_process(COMMAND "${CLI}" bake "${SCENE}" "${ATLAS}" --sun-angle "${ANGLE}"
        RESULT_VARIABLE STATUS OUTPUT_VARIABLE LOG ERROR_VARIABLE ERROR)
    if(STATUS EQUAL 0 OR NOT ERROR MATCHES "lightmap error:")
        message(FATAL_ERROR "Invalid sun angle ${ANGLE} was not rejected: ${LOG}${ERROR}")
    endif()
endforeach()
execute_process(COMMAND "${CLI}" bake "${SCENE}" "${ATLAS}" --sun-angle
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE LOG ERROR_VARIABLE ERROR)
if(STATUS EQUAL 0 OR NOT ERROR MATCHES "Missing option value")
    message(FATAL_ERROR "Missing sun angle was not rejected: ${LOG}${ERROR}")
endif()
foreach(PROBE_OPTION IN ITEMS --probe-size --probe-samples --probe-filter-samples)
    execute_process(COMMAND "${CLI}" bake "${SCENE}" "${ATLAS}" "${PROBE_OPTION}" 0
        RESULT_VARIABLE STATUS OUTPUT_VARIABLE LOG ERROR_VARIABLE ERROR)
    if(STATUS EQUAL 0 OR NOT ERROR MATCHES "lightmap error:")
        message(FATAL_ERROR "Invalid probe option ${PROBE_OPTION} accepted: ${LOG}${ERROR}")
    endif()
endforeach()
set(BACKENDS cpu)
if(ENABLE_VULKAN)
    list(APPEND BACKENDS vulkan)
endif()
foreach(BACKEND IN LISTS BACKENDS)
    foreach(ANGLE IN ITEMS 0 0.53 20)
        execute_process(COMMAND "${CLI}" bake "${SCENE}" "${ATLAS}" --size 16 --samples 8 --bounces 1
            --probe-size 4 --probe-samples 8 --probe-filter-samples 16 --padding 2 --backend "${BACKEND}" --sun-angle "${ANGLE}"
            RESULT_VARIABLE STATUS OUTPUT_VARIABLE LOG ERROR_VARIABLE ERROR)
        if(NOT STATUS EQUAL 0 OR NOT LOG MATCHES "sun_angle_degrees=${ANGLE}")
            message(FATAL_ERROR "Valid ${BACKEND} sun angle ${ANGLE} failed: ${LOG}${ERROR}")
        endif()
        execute_process(COMMAND "${CLI}" inspect "${ATLAS}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE LOG ERROR_VARIABLE ERROR)
        if(NOT STATUS EQUAL 0 OR NOT LOG MATCHES "atlas=16x16" OR NOT LOG MATCHES "probe_size=4 probe_mips=3")
            message(FATAL_ERROR "CLI saved atlas did not roundtrip: ${LOG}${ERROR}")
        endif()
    endforeach()
endforeach()
file(REMOVE "${SCENE}" "${ATLAS}")
message(STATUS "PASS CLI finite sun valid/invalid values, selected angle report and saved atlas roundtrip")
