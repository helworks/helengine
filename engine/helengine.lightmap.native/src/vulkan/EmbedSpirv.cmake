if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "SPIR-V embedding requires INPUT and OUTPUT")
endif()
file(READ "${INPUT}" SPIRV_HEX HEX)
string(LENGTH "${SPIRV_HEX}" HEX_LENGTH)
math(EXPR REMAINDER "${HEX_LENGTH} % 8")
if(NOT REMAINDER EQUAL 0 OR HEX_LENGTH LESS 40)
    message(FATAL_ERROR "Invalid SPIR-V byte length")
endif()
set(WORDS "")
math(EXPR LAST "${HEX_LENGTH} - 8")
foreach(OFFSET RANGE 0 ${LAST} 8)
    string(SUBSTRING "${SPIRV_HEX}" ${OFFSET} 2 B0)
    math(EXPR P1 "${OFFSET}+2")
    math(EXPR P2 "${OFFSET}+4")
    math(EXPR P3 "${OFFSET}+6")
    string(SUBSTRING "${SPIRV_HEX}" ${P1} 2 B1)
    string(SUBSTRING "${SPIRV_HEX}" ${P2} 2 B2)
    string(SUBSTRING "${SPIRV_HEX}" ${P3} 2 B3)
    string(APPEND WORDS "0x${B3}${B2}${B1}${B0}u,\n")
endforeach()
file(WRITE "${OUTPUT}" "#pragma once\n#include <cstdint>\nnamespace hellm::detail {\n/// <summary>Build-generated Vulkan 1.2 ray-query shader words.</summary>\ninline constexpr uint32_t TransportSpirv[] = {\n${WORDS}};\n}\n")
