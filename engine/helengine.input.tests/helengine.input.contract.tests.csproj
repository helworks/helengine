<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Match the portable iOS contract rather than the authoring host's desktop input fields. -->
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the actual portable contract so native event replay uses normal generated types, without Core fixtures. -->
    <Compile Include="..\helengine.input\IInputBackend.cs" />
    <Compile Include="..\helengine.input\InputFrameState.cs" />
    <Compile Include="..\helengine.input\InputPointerState.cs" />
    <Compile Include="..\helengine.input\InputPointerButton.cs" />
    <Compile Include="..\helengine.input\InputTouchState.cs" />
    <Compile Include="..\helengine.input\InputTouchPhase.cs" />
    <Compile Include="..\helengine.input\InputTouchTool.cs" />
    <Compile Include="..\helengine.input\InputPenAxes.cs" />
    <Compile Include="..\helengine.input\InputGamepadState.cs" />
    <Compile Include="..\helengine.input\InputGamepadButton.cs" />
    <Compile Include="..\helengine.input\InputTextState.cs" />
  </ItemGroup>
</Project>
