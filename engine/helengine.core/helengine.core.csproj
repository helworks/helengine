<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DefineConstants Condition="'$(CookedViewportLayout)' == 'true'">$(DefineConstants);HELENGINE_RUNTIME_COOKED_VIEWPORT_LAYOUT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\helengine.input\*.cs" Link="input\%(Filename)%(Extension)" />
    <Compile Remove="..\helengine.input\TypeForwarders.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\helengine.nativeownership\helengine.nativeownership.csproj" />
  </ItemGroup>
  <Import Project="..\..\build\NumericPrecision.targets" />

</Project>
