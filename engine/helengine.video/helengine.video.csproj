<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- The edit format compiles to helengine.media compositions. -->
  <ItemGroup>
    <ProjectReference Include="..\helengine.media\helengine.media.csproj" />
  </ItemGroup>

  <!-- Graphic templates are GraphicTemplateAsset definitions (helengine.core) stored as .hgraphic files (helengine.files). -->
  <ItemGroup>
    <ProjectReference Include="..\helengine.core\helengine.core.csproj" />
    <ProjectReference Include="..\helengine.files\helengine.files.csproj" />
  </ItemGroup>
  <!-- Overlay timelines are Helengine Timelines (tools-only authoring module) flattened and compiled into layers. -->
  <ItemGroup>
    <ProjectReference Include="..\helengine.timeline\helengine.timeline.csproj" />
  </ItemGroup>
</Project>
