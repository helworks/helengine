<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\helengine.baseplatform\helengine.baseplatform.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\helengine.core\helengine.core.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\helengine.managed\helengine.managed.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\helengine.shader\helengine.shader.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\helengine.shader.compilation\helengine.shader.compilation.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\helengine.files\helengine.files.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\helengine.physics3d\helengine.physics3d.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\helengine.helphysics\helengine.helphysics.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\helengine.directx11\helengine.directx11.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\helengine.platforms\helengine.platforms.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\helengine.projectfile\helengine.projectfile.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\helengine.vulkan\helengine.vulkan.csproj" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.2.1" />
    <PackageReference Include="AstcSharp" Version="2.0.0" />
    <PackageReference Include="AssetRipper.TextureDecoder" Version="2.6.3" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.11" />
    <PackageReference Include="Svg" Version="3.4.8" />
  </ItemGroup>

  <ItemGroup>
    <None Update="shaders\builtin\*.hlsl">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Native varargs require a compiler-owned ABI on Apple arm64. Keep the three
       authoring wrappers universal, incremental, and inside the normal artifact root. -->
  <Target Name="BuildDarwinAuthoringNativeShim"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))"
          Inputs="$(MSBuildProjectDirectory)/native/darwin/authoring_posix.c;$(MSBuildProjectFullPath)"
          Outputs="$(IntermediateOutputPath)native/libhelengine.authoring.native.dylib">
    <MakeDir Directories="$(IntermediateOutputPath)native" />
    <Exec Command="xcrun --sdk macosx clang -std=c11 -O2 -Wall -Wextra -Werror -fvisibility=hidden -dynamiclib -arch arm64 -arch x86_64 -mmacosx-version-min=11.0 -Wl,-install_name,@rpath/libhelengine.authoring.native.dylib &quot;$(MSBuildProjectDirectory)/native/darwin/authoring_posix.c&quot; -o &quot;$(IntermediateOutputPath)native/libhelengine.authoring.native.dylib&quot;" />
  </Target>

  <!-- Register on every invocation, including when compilation is up to date,
       so project references and dotnet publish carry the native dependency. -->
  <Target Name="RegisterDarwinAuthoringNativeShim"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="BuildDarwinAuthoringNativeShim"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <ItemGroup>
      <Content Include="$(IntermediateOutputPath)native/libhelengine.authoring.native.dylib"
               Link="libhelengine.authoring.native.dylib"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- WriteOnlyWhenDifferent is required, not cosmetic. The emitted content is a constant path, but
       rewriting the file unconditionally gives it a new timestamp on every build, which makes CoreCompile
       see a newer input than the assembly and recompile this project every time. That cascades to the
       eleven projects referencing it, and it changes helengine.editor.dll's timestamp, which invalidates
       the editor's project-script build fingerprint and rebuilds game scripts on every launch. -->
  <Target Name="EmbedHelengineSourceRootManifest" BeforeTargets="CoreCompile">
    <WriteLinesToFile
      File="$(IntermediateOutputPath)HelengineSourceRoot.g.cs"
      Lines="namespace helengine.editor { internal static class GeneratedHelengineSourceRoot { internal const string Path = @&quot;$(MSBuildProjectDirectory)\..\..&quot;%3B } }"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)HelengineSourceRoot.g.cs" />
    </ItemGroup>
  </Target>

</Project>
